# ==============================================================================
# Omnididact 生产环境变量配置模板 (.env.example)
# 使用方法：复制本文件为 .env，并根据部署需求填写具体配置：
#   cp .env.example .env
# ==============================================================================

# 服务基础网络配置
HOST=0.0.0.0
PORT=8000
RELOAD=false

# 安全与身份认证 (P0 安全核心，强烈建议生产环境配置复杂强随机字符串)
# 开启后全站 API 接口及页面均需 Token 鉴权，支持 Web 端登录及 HttpOnly Cookie
OMNIDIDACT_API_TOKEN=your_secure_random_token_here

# 跨域白名单 (按需配置，多个用英文逗号分隔)
OMNIDIDACT_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:8000

# 生产环境建议关闭调试敏感信息 (false)
OMNIDIDACT_ENABLE_DEBUG=false

# 可选：模型提供方环境变量密钥注入 (将自动覆盖 config.json 中的对应密钥)
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# NVIDIA_API_KEY=nvapi-...
# CLOUDFLARE_API_KEY=cfut_...
